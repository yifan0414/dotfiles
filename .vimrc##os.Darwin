" ========== 基础 ==========
set nocompatible
filetype plugin indent on
syntax on
set encoding=utf-8

" ========== 显示 ==========
set number
set relativenumber
set showcmd
set wildmenu

" ========== 缩进 / 搜索 ==========
set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab
set smartindent
set autoindent

set ignorecase
set smartcase
set incsearch
set hlsearch

" ========== 编辑体验 ==========
set mouse=a
if has('clipboard')
  set clipboard=unnamedplus
endif
set backspace=indent,eol,start
set hidden
set updatetime=300
set rtp+=/opt/homebrew/opt/fzf

" ========== 持久化 undo ==========
if has('persistent_undo')
  set undofile
  set undodir=~/.vim/undo//
  set undolevels=10000
endif

" ========== vim-plug ==========
call plug#begin('~/.vim/plugged')

" gcc 注释当前行，gc 作用于可视模式选中内容
Plug 'tpope/vim-commentary'

call plug#end()

" ========== 一些常用快捷键 ==========
let mapleader=" "

" 快速保存 / 退出
nnoremap <leader>w :w<CR>
nnoremap <leader>q :q<CR>

" 清除搜索高亮
nnoremap <leader>h :nohlsearch<CR>

" 针对常见配置文件使用 2 空格缩进
autocmd FileType yaml,json,sh,zsh,bash,lua,vim setlocal tabstop=2 shiftwidth=2 softtabstop=2 expandtab

" Makefile 必须保留 Tab
autocmd FileType make setlocal noexpandtab
