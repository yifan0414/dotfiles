#!/usr/bin/env bash

set -euo pipefail

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
export GIT_TERMINAL_PROMPT=0

commit_message=""

usage() {
  cat <<'EOF'
Usage: yadm-daily-backup [-m MESSAGE]

Options:
  -m, --message MESSAGE  Use MESSAGE as the commit message.
  -h, --help             Show this help text.
EOF
}

while (($# > 0)); do
  case "$1" in
    -m|--message)
      if (($# < 2)) || [[ -z "$2" ]]; then
        echo "Missing commit message for $1." >&2
        usage >&2
        exit 1
      fi
      commit_message="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

repo_root="${HOME}"
archive_path="${HOME}/.local/share/yadm/archive"
cd "${repo_root}"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/yadm-daily-backup"
lock_dir="$state_dir/lock"
mkdir -p "$state_dir"
if ! mkdir "$lock_dir" 2>/dev/null; then
  echo "Another backup may be running. If none is running, remove $lock_dir and retry." >&2
  exit 75
fi
trap 'rmdir "$lock_dir"' EXIT

if ! branch="$(yadm symbolic-ref --quiet --short HEAD)"; then
  echo "Detached HEAD; select a branch before syncing." >&2
  exit 1
fi

for operation in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
  if [[ -e "$(yadm rev-parse --git-path "$operation")" ]]; then
    echo "Unfinished Git operation ($operation); resolve it before syncing." >&2
    exit 1
  fi
done

if [[ -n "$(yadm ls-files -u)" ]]; then
  echo "Unresolved conflicts; resolve them before syncing." >&2
  exit 1
fi

has_upstream() {
  yadm rev-parse --verify --quiet '@{u}' >/dev/null 2>&1
}

sync_from_remote() {
  if ! has_upstream; then
    echo "No upstream configured for ${branch}; skipping pull."
    return 0
  fi

  echo "Pulling latest changes from the configured upstream of ${branch}."
  yadm pull --rebase --autostash
  # Applying an autostash can leave conflicts even when pull exits successfully.
  if [[ -n "$(yadm ls-files -u)" ]]; then
    echo "Pull left conflicts; resolve them before syncing." >&2
    return 1
  fi
}

sync_from_remote

# Stage tracked dotfiles without traversing protected macOS directories.
yadm add -u

# Stage the encrypted archive when present so private files can be backed up.
if [[ -f "${archive_path}" ]]; then
  yadm add "${archive_path}"
fi

if yadm diff --cached --quiet; then
  echo "No tracked changes to commit."
else
  if [[ -n "$commit_message" ]]; then
    yadm commit -m "$commit_message"
  else
    timestamp="$(date '+%Y-%m-%d %H:%M:%S %z')"
    yadm commit -m "Daily backup ${timestamp}"
  fi
fi

# Pull again in case another machine pushed while this run was committing.
sync_from_remote

if ! has_upstream; then
  echo "No upstream configured for ${branch}; skipping push."
  exit 0
fi

read -r ahead behind <<<"$(yadm rev-list --left-right --count HEAD...@{u})"

if (( ahead == 0 )); then
  echo "Already in sync with the configured upstream of ${branch}."
  exit 0
fi

upstream_remote="$(yadm gitconfig --get "branch.${branch}.remote")"
upstream_ref="$(yadm gitconfig --get "branch.${branch}.merge")"
echo "Pushing ${ahead} local commit(s) to ${upstream_remote}/${upstream_ref}."
yadm push "$upstream_remote" "HEAD:$upstream_ref"
