##################################################################
### Powerlevel10k instant prompt; keep interactive code above. ###
##################################################################
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

#############################################
### Helper functions for PATH management. ###
#############################################
prepend_path() {
  [[ -d "$1" ]] && export PATH="$1:$PATH"
}

################################
### Oh My Zsh core settings. ###
################################
export ZSH="$HOME/.oh-my-zsh"
export PATH="$HOME/.fzf/bin:$PATH"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git fzf z fzf-tab zsh-autosuggestions zsh-syntax-highlighting)

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  printf '[dotfiles] oh-my-zsh is not installed yet; run yadm bootstrap\n' >&2
fi

##########################################
### Locale and default tool selection. ###
##########################################
export LANG="en_US.UTF-8"
export EDITOR="vim"
export VISUAL="vim"
export LESSCHARSET="utf-8"
export RANGER_LOAD_DEFAULT_RC="false"
export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"
export GOPATH="$HOME/go"

################################################
### Linux toolchain and runtime environment. ###
################################################
prepend_path "$HOME/.local/bin"

###########################################
### Proxy defaults for network tooling. ###
###########################################
[[ -r "$HOME/.config/yadm/shell/proxy.zsh" ]] && source "$HOME/.config/yadm/shell/proxy.zsh"

# 兜底: 需要彻底剥离代理变量时用 hfnp <cmd>
hfnp() {
  env -u http_proxy -u https_proxy -u all_proxy \
      -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY "$@"
}

#######################
### Common aliases. ###
#######################
if command -v fdfind >/dev/null 2>&1; then
  alias fd="fdfind"
fi

if command -v eza >/dev/null 2>&1; then
  alias ls="eza"
  alias ll="eza -all"
elif command -v exa >/dev/null 2>&1; then
  alias ls="exa"
  alias ll="exa -all"
else
  alias ll="ls -all"
fi

alias clear="clear -x"

# Resolve python3 through PATH, including the currently activated environment.
alias python=python3

yb() {
  "$HOME/.local/bin/yadm-daily-backup" "$@"
}

###############################################
### Key bindings for quick screen clearing. ###
###############################################
bindkey "^[l" clear-screen
bindkey "^L" clear-screen

##############################
### Convenience functions. ###
##############################
Man() {
  man -k . | fzf | awk '{print $1}' | xargs man
}

ya() {
  local tmp
  local cwd

  tmp="$(mktemp -t "yazi-cwd.XXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [[ -n "$cwd" ]] && [[ "$cwd" != "$PWD" ]]; then
    cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

###################################
### Syntax highlighting colors. ###
###################################
if typeset -p FAST_HIGHLIGHT_STYLES >/dev/null 2>&1; then
  FAST_HIGHLIGHT_STYLES[comment]="fg=#7fb4ca"
fi

#################################################
### Conda integration for interactive shells. ###
#################################################
for __conda_root in "${DOTFILES_CONDA_ROOT:-}" /opt/miniforge3 "$HOME/miniforge3" "$HOME/miniconda3" /opt/miniconda3 /opt/anaconda3; do
  if [[ "$__conda_root" == /* && -r "$__conda_root/etc/profile.d/conda.sh" ]]; then
    source "$__conda_root/etc/profile.d/conda.sh"
    break
  fi
done
unset __conda_root

#################################################
###                 NVM                       ###
#################################################
export NVM_DIR="$HOME/.nvm"

if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  source "$NVM_DIR/nvm.sh"
elif [[ -s "/opt/homebrew/opt/nvm/nvm.sh" ]]; then
  source "/opt/homebrew/opt/nvm/nvm.sh"
elif [[ -s "/usr/local/opt/nvm/nvm.sh" ]]; then
  source "/usr/local/opt/nvm/nvm.sh"
fi

if [[ -s "$NVM_DIR/bash_completion" ]]; then
  source "$NVM_DIR/bash_completion"
elif [[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ]]; then
  source "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
elif [[ -s "/usr/local/opt/nvm/etc/bash_completion.d/nvm" ]]; then
  source "/usr/local/opt/nvm/etc/bash_completion.d/nvm"
fi

#################################################
### Prompt and shell completion integrations. ###
#################################################
# Ubuntu 20.04 ships an older fzf that doesn't support backward-delete-char/eof.
zstyle ':fzf-tab:*' fzf-bindings-default \
  'tab:down' 'btab:up' 'change:top' 'ctrl-space:toggle' \
  'bspace:backward-delete-char' 'ctrl-h:backward-delete-char'

[[ -f "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"

# The Oh My Zsh fzf plugin initializes fzf before fzf-tab.
# Sourcing ~/.fzf.zsh again would overwrite fzf-tab's Tab binding.

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.

#############################
### GPG (pinentry needs a TTY). ###
#############################
export GPG_TTY=$(tty)

# 公共配置保留在 .zshrc##os.*；基础工具初始化后再应用本机差异。
# yadm 按 hostname 选择 .zshrc.local；跟踪 ##hostname.* 候选，不跟踪生成的链接。
# 私有设置及需提前读取的值仍放 ~/.config/yadm/local/shell.zsh，由 .zshenv 加载。
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
