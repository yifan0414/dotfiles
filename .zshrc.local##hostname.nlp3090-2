# 团队共享文件默认允许组内写入。
umask 0002

##########################################
### Development environment variables. ###
##########################################
[[ -d "$HOME/ics2020/abstract-machine" ]] && export AM_HOME="$HOME/ics2020/abstract-machine"
[[ -d "$HOME/ics2020/nemu" ]] && export NEMU_HOME="$HOME/ics2020/nemu"
[[ -d "$HOME/ics2020/navy-apps" ]] && export NAVY_HOME="$HOME/ics2020/navy-apps"
[[ -d "$HOME/ysyx-workbench/npc" ]] && export NPC_HOME="$HOME/ysyx-workbench/npc"

# 补充本机工具路径，保留已激活环境的优先级。
for local_tool_bin in /usr/local/go/bin "$HOME/miniforge3/bin"; do
  if [[ -d "$local_tool_bin" ]]; then
    case ":$PATH:" in
      *":$local_tool_bin:"*) ;;
      *) export PATH="$PATH:$local_tool_bin" ;;
    esac
  fi
done
unset local_tool_bin

# 镜像及其 hf.co 下载重定向默认直连；保留调用方的网络设置。
export NO_PROXY="${NO_PROXY-${no_proxy-hf-mirror.com,.hf-mirror.com,hf.co,.hf.co,localhost,127.0.0.1}}"
export no_proxy="${no_proxy-$NO_PROXY}"

# nlp3090-2：保留这台 3090×2 服务器的缓存、模型和 CUDA 设置。
if [[ -d "/hdd1_4t/yifan/shared" ]]; then
  export UV_CACHE_DIR="/hdd1_4t/yifan/shared/uv-cache"
  export UV_LINK_MODE="hardlink"

  export CUDA_HOME="/usr/local/cuda-12.8"
  case ":$PATH:" in
    *":$CUDA_HOME/bin:"*) ;;
    *) export PATH="$CUDA_HOME/bin:$PATH" ;;
  esac
  case ":${LD_LIBRARY_PATH:-}:" in
    *":$CUDA_HOME/lib64:"*) ;;
    *) export LD_LIBRARY_PATH="$CUDA_HOME/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ;;
  esac
  export MODEL_NAME="/hdd1_4t/yifan/shared/models/Qwen2.5-VL-7B-Instruct"
fi

if [[ -d "/hdd1_4t/yifan/lmms-eval" ]] && command -v direnv >/dev/null 2>&1; then
  export DIRENV_LOG_FORMAT=""
  eval "$(direnv hook zsh)"
fi

if [[ -f "/hdd1_4t/yifan/shared/env/shared_paths.sh" ]]; then
  source "/hdd1_4t/yifan/shared/env/shared_paths.sh"
fi

# Hugging Face：共享下载缓存，个人配置和访问策略。
export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"
export HF_HUB_CACHE="${HF_HUB_CACHE:-${HUGGINGFACE_HUB_CACHE:-/hdd1_4t/shared/huggingface/hub}}"
export HF_ENDPOINT="${HF_ENDPOINT:-https://hf-mirror.com}"
export HF_HUB_DISABLE_IMPLICIT_TOKEN="${HF_HUB_DISABLE_IMPLICIT_TOKEN:-1}"
