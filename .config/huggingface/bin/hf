#!/bin/sh
# CLI tooling is independent of project environments; auth always uses the Hub.
set -eu
if [ "${1:-}" = auth ]; then
    if [ "${HF_CACHE_SCOPE:-}" = public ]; then
        printf '%s\n' 'Use hf-private hf auth ... for personal authentication.' >&2
        exit 2
    fi
    exec /usr/local/bin/hf-private /opt/huggingface-tools/bin/hf "$@"
fi
exec /opt/huggingface-tools/bin/hf "$@"
