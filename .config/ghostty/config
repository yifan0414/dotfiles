# Synced from ~/.config/kitty/*.conf
# Ghostty can match most visual settings and keybindings, but not every Kitty-only feature.

shell-integration = detect
shell-integration-features = no-cursor,sudo,title,ssh-env,ssh-terminfo,path

# Fonts
font-family = "Maple Mono NF CN"
font-family-bold = "Maple Mono NF CN"
font-family-italic = "Maple Mono NF CN"
font-family-bold-italic = "Maple Mono NF CN"
font-style = Medium
font-style-bold = Bold
font-style-italic = "Medium Italic"
font-style-bold-italic = "Bold Italic"
font-feature = +cv03,+zero
font-size = 14

# Kitty modify_font equivalents
adjust-cell-height = 10%
adjust-underline-position = 2
adjust-underline-thickness = 50%

# Cursor
cursor-style = block
cursor-style-blink = false
cursor-color = cell-foreground
cursor-text = cell-background

# Window UI
background-opacity = 1
background-opacity-cells = false
background-blur = false
window-padding-x = 4,0
window-padding-y = 0
window-padding-balance = false
window-padding-color = background
confirm-close-surface = false
copy-on-select = false
scrollback-limit = 10000000
unfocused-split-opacity = 1

# macOS behavior
macos-titlebar-style = transparent
macos-option-as-alt = true

# Themes translated from Kitty light/dark theme files; dark cursor follows current-theme.conf.
theme = light:Catppuccin Latte,dark:Kanagawabones

# Keybindings mapped from Kitty where Ghostty has equivalent actions.
# Defaults are left intact unless they conflict.
keybind = super+c=copy_to_clipboard:mixed
keybind = super+v=paste_from_clipboard
keybind = super+enter=new_window
keybind = ctrl+g>c=new_tab
keybind = ctrl+super+,=reload_config
keybind = ctrl+g>-=new_split:down
keybind = ctrl+g>[=write_scrollback_file:open,plain
keybind = ctrl+g>r=prompt_tab_title
keybind = ctrl+g>n=next_tab
keybind = ctrl+g>z=jump_to_prompt:-1
keybind = ctrl+g>x=jump_to_prompt:1
keybind = ctrl+g>.=jump_to_prompt:0

# Kitty-only features without Ghostty equivalents:
# - allow_remote_control / listen_on unix:/tmp/kitty
# - set_colors on ctrl+g>d and ctrl+g>l
# - show/copy last command output actions on ctrl+g>g/v/f/y/shift+y
# - hide only the window title text while keeping the same titlebar behavior

keybind = global:ctrl+grave_accent=toggle_quick_terminal

quick-terminal-position = bottom
# Kitty quick-access-terminal.conf uses 15 lines; Ghostty accepts px/% only.
quick-terminal-size = 240px
quick-terminal-autohide = true
