#!/usr/bin/env bash

set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

state_dir="${HOME}/.local/state/yadm-backup-on-wake"
uuid_file="${state_dir}/sleepwake.uuid"
lock_dir="${state_dir}/lock"
backup_cmd="${HOME}/.local/bin/yadm-daily-backup"

mkdir -p "${state_dir}"

get_sleepwake_uuid() {
  ioreg -r -c IOPMrootDomain -d 1 | sed -n 's/.*"SleepWakeUUID" = "\(.*\)"/\1/p'
}

current_uuid="$(get_sleepwake_uuid)"

if [[ -z "${current_uuid}" ]]; then
  echo "Unable to read SleepWakeUUID from IOPMrootDomain." >&2
  exit 78
fi

if [[ ! -x "${backup_cmd}" ]]; then
  echo "Backup command is missing or not executable: ${backup_cmd}" >&2
  exit 78
fi

previous_uuid=""
if [[ -f "${uuid_file}" ]]; then
  previous_uuid="$(<"${uuid_file}")"
fi

if [[ "${current_uuid}" == "${previous_uuid}" ]]; then
  exit 0
fi

printf '%s\n' "${current_uuid}" > "${uuid_file}"

# Prime state on the first launch so login/reload does not trigger a backup.
if [[ -z "${previous_uuid}" ]]; then
  echo "Initialized wake state with SleepWakeUUID ${current_uuid}."
  exit 0
fi

if ! mkdir "${lock_dir}" 2>/dev/null; then
  echo "Backup is already running; skipping duplicate wake event ${current_uuid}."
  exit 0
fi

cleanup() {
  rmdir "${lock_dir}"
}

trap cleanup EXIT

echo "Detected wake event ${previous_uuid} -> ${current_uuid}; running yadm-daily-backup."
"${backup_cmd}"
