<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yifan.yadm-daily-backup</string>

  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/yifan/.local/bin/yadm-backup-on-wake</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>600</integer>

  <key>StandardOutPath</key>
  <string>/Users/yifan/Library/Logs/yadm-daily-backup.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/yifan/Library/Logs/yadm-daily-backup.err.log</string>
</dict>
</plist>
