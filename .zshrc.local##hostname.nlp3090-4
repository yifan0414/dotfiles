# nlp3090-4：保留这台 3090×4 服务器的模型和 CUDA 设置。
if [[ -d "/ssd_2t/yifan/" ]]; then
  export CUDA_HOME="/usr/local/cuda-12.8"
  case ":$PATH:" in
    *":$CUDA_HOME/bin:"*) ;;
    *) export PATH="$CUDA_HOME/bin:$PATH" ;;
  esac
  case ":${LD_LIBRARY_PATH:-}:" in
    *":$CUDA_HOME/lib64:"*) ;;
    *) export LD_LIBRARY_PATH="$CUDA_HOME/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ;;
  esac
  export MODEL_NAME="/ssd_2t/shared/models/Qwen2.5-VL-7B-Instruct"
fi

# BEGIN managed Hugging Face settings
# Hugging Face: shared downloads and personal caches.
export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"
export HF_PUBLIC_HUB_CACHE=/ssd_2t/shared/huggingface/hub
export HF_PUBLIC_ENDPOINT=https://hf-mirror.com
export HF_HUB_CACHE="${HF_HUB_CACHE:-${HUGGINGFACE_HUB_CACHE:-$HF_PUBLIC_HUB_CACHE}}"
export HUGGINGFACE_HUB_CACHE="${HUGGINGFACE_HUB_CACHE:-$HF_HUB_CACHE}"
export HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$HF_HOME/datasets}"
export HF_XET_CACHE="${HF_XET_CACHE:-$HF_HOME/xet}"
export HF_ASSETS_CACHE="${HF_ASSETS_CACHE:-$HF_HOME/assets}"
export HF_TOKEN_PATH="${HF_TOKEN_PATH:-$HF_HOME/token}"
export HF_ENDPOINT="${HF_ENDPOINT:-$HF_PUBLIC_ENDPOINT}"
export HF_HUB_DISABLE_IMPLICIT_TOKEN="${HF_HUB_DISABLE_IMPLICIT_TOKEN:-1}"
# END managed Hugging Face settings
