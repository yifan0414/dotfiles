##################################################################
### Powerlevel10k instant prompt; keep interactive code above. ###
##################################################################
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

#############################################
### Helper functions for PATH management. ###
#############################################
prepend_path() {
  [[ -d "$1" ]] && export PATH="$1:$PATH"
}

################################
### Oh My Zsh core settings. ###
################################
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git fzf zsh-syntax-highlighting zsh-autosuggestions z fzf-tab)

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  printf '[dotfiles] oh-my-zsh is not installed yet; run yadm bootstrap\n' >&2
fi

##########################################
### Locale and default tool selection. ###
##########################################
export LANG="en_US.UTF-8"
export EDITOR="nvim"
export LESSCHARSET="utf-8"
export RANGER_LOAD_DEFAULT_RC="false"
export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"
export GOPATH="$HOME/go"

export HF_ENDPOINT=https://hf-mirror.com

##########################################
### Development environment variables. ###
##########################################
[[ -d "$HOME/ics2020/abstract-machine" ]] && export AM_HOME="$HOME/ics2020/abstract-machine"
[[ -d "$HOME/ics2020/nemu" ]] && export NEMU_HOME="$HOME/ics2020/nemu"
[[ -d "$HOME/ics2020/navy-apps" ]] && export NAVY_HOME="$HOME/ics2020/navy-apps"
[[ -d "$HOME/ysyx-workbench/npc" ]] && export NPC_HOME="$HOME/ysyx-workbench/npc"

################################################
### Linux toolchain and runtime environment. ###
################################################
prepend_path "$HOME/.local/bin"
prepend_path "/usr/local/go/bin"
prepend_path "$HOME/miniforge3/bin"

###########################################
### Proxy defaults for network tooling. ###
###########################################
proxy_host="${DOTFILES_PROXY_HOST:-127.0.0.1}"
proxy_port="${DOTFILES_PROXY_PORT:-7897}"
proxy_scheme="${DOTFILES_PROXY_SCHEME:-http}"
proxy_url="${DOTFILES_PROXY_URL:-${proxy_scheme}://${proxy_host}:${proxy_port}}"
git_proxy_url="${DOTFILES_GIT_PROXY_URL:-$proxy_url}"

proxy_on() {
  export http_proxy="$proxy_url"
  export https_proxy="$proxy_url"
  export all_proxy="$proxy_url"
  export HTTP_PROXY="$proxy_url"
  export HTTPS_PROXY="$proxy_url"
  export ALL_PROXY="$proxy_url"

  if command -v git >/dev/null 2>&1; then
    git config --global http.proxy "$git_proxy_url"
    git config --global https.proxy "$git_proxy_url"
  fi
}

# proxy_on

#######################
### Common aliases. ###
#######################
if command -v fdfind >/dev/null 2>&1; then
  alias fd="fdfind"
fi

if command -v eza >/dev/null 2>&1; then
  alias ls="eza"
  alias ll="eza -all"
elif command -v exa >/dev/null 2>&1; then
  alias ls="exa"
  alias ll="exa -all"
else
  alias ll="ls -all"
fi

if command -v nvim >/dev/null 2>&1; then
  alias vim="nvim"
fi

alias curl="curl -x ${proxy_url}"

if command -v python3 >/dev/null 2>&1; then
  alias python="python3"
fi

yb() {
  "$HOME/.local/bin/yadm-daily-backup" "$@"
}

###############################################
### Key bindings for quick screen clearing. ###
###############################################
bindkey "^[l" clear-screen
bindkey "^L" clear-screen

##############################
### Convenience functions. ###
##############################
Man() {
  man -k . | fzf | awk '{print $1}' | xargs man
}

ya() {
  local tmp
  local cwd

  tmp="$(mktemp -t "yazi-cwd.XXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [[ -n "$cwd" ]] && [[ "$cwd" != "$PWD" ]]; then
    cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

###################################
### Syntax highlighting colors. ###
###################################
if typeset -p FAST_HIGHLIGHT_STYLES >/dev/null 2>&1; then
  FAST_HIGHLIGHT_STYLES[comment]="fg=#7fb4ca"
fi

#################################################
### Conda integration for interactive shells. ###
#################################################
if [[ -x "/opt/miniconda3/bin/conda" ]]; then
  if __conda_setup="$("/opt/miniconda3/bin/conda" 'shell.zsh' 'hook' 2>/dev/null)"; then
    eval "$__conda_setup"
  elif [[ -f "/opt/miniconda3/etc/profile.d/conda.sh" ]]; then
    source "/opt/miniconda3/etc/profile.d/conda.sh"
  else
    prepend_path "/opt/miniconda3/bin"
  fi
  unset __conda_setup
fi

if [[ -x "/opt/anaconda3/bin/conda" ]]; then
  if __conda_setup="$("/opt/anaconda3/bin/conda" 'shell.zsh' 'hook' 2>/dev/null)"; then
    eval "$__conda_setup"
  elif [[ -f "/opt/anaconda3/etc/profile.d/conda.sh" ]]; then
    source "/opt/anaconda3/etc/profile.d/conda.sh"
  else
    prepend_path "/opt/anaconda3/bin"
  fi
  unset __conda_setup
fi
#########################################
### Shared project shell defaults.     ###
#########################################
if [[ -f "/hdd1_4t/yifan/shared/env/shared_paths.sh" ]]; then
  source "/hdd1_4t/yifan/shared/env/shared_paths.sh"
fi

