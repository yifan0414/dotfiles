##################################################################
### Powerlevel10k instant prompt; keep interactive code above. ###
##################################################################
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

#############################################
### Helper functions for PATH management. ###
#############################################
prepend_path() {
  [[ -d "$1" ]] && export PATH="$1:$PATH"
}

gcpush() {
  local git_status msg

  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "❌ 当前目录不是 Git 仓库"
    return 1
  }

  git_status="$(git status --short --untracked-files=no)"

  if [[ -z "$git_status" ]]; then
    echo "✅ 没有已追踪文件改动"
    return 0
  fi

  msg="$(printf '%s\n' "$git_status" | codex exec --sandbox read-only \
'根据下面的 git status --short 输出，生成一个简短英文 git commit message。
只输出 commit message，不要解释，不要使用 Markdown。')"

  if [[ -z "$msg" ]]; then
    msg="Update tracked files"
  fi

  echo "📝 Commit message: $msg"

  git add .

  if git diff --cached --quiet; then
    echo "✅ 没有 staged 改动"
    return 0
  fi

  git commit -m "$msg"
  git push
}

################################
### Oh My Zsh core settings. ###
################################
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git fzf zsh-syntax-highlighting zsh-autosuggestions z fzf-tab)
ZVM_CURSOR_STYLE_ENABLED=false

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  printf '[dotfiles] oh-my-zsh is not installed yet; run yadm bootstrap\n' >&2
fi

#################################################
### Kitty command-block shell integration.    ###
#################################################
if [[ -n "$KITTY_INSTALLATION_DIR" ]]; then
  export KITTY_SHELL_INTEGRATION="${KITTY_SHELL_INTEGRATION:-enabled}"
  autoload -Uz -- "$KITTY_INSTALLATION_DIR"/shell-integration/zsh/kitty-integration
  kitty-integration
  unfunction kitty-integration 2>/dev/null || true
fi

#######################################
### fzf-tab Catppuccin Latte theme. ###
#######################################
zstyle ':fzf-tab:*' fzf-flags \
  --height=40% \
  --layout=reverse \
  --border \
  --color=bg:#eff1f5,bg+:#ccd0da,fg:#4c4f69,fg+:#4c4f69 \
  --color=hl:#d20f39,hl+:#d20f39 \
  --color=prompt:#8839ef,pointer:#dc8a78,marker:#7287fd \
  --color=spinner:#dc8a78,header:#d20f39,info:#8839ef,border:#9ca0b0
zstyle ':fzf-tab:*' fzf-pad 4

FZF_TAB_GROUP_COLORS=(
  $'\033[38;2;136;57;239m'
  $'\033[38;2;30;102;245m'
  $'\033[38;2;64;160;43m'
  $'\033[38;2;223;142;29m'
  $'\033[38;2;210;15;57m'
  $'\033[38;2;4;165;229m'
  $'\033[38;2;254;100;11m'
  $'\033[38;2;220;138;120m'
)
zstyle ':fzf-tab:*' group-colors $FZF_TAB_GROUP_COLORS

##########################################
### Locale and default tool selection. ###
##########################################
export LANG="en_US.UTF-8"
export EDITOR="nvim"
export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles"

################################################
### macOS toolchain and runtime environment. ###
################################################
export LDFLAGS="-L/opt/homebrew/opt/llvm/lib"
export CPPFLAGS="-I/opt/homebrew/opt/llvm/include"

prepend_path "$HOME/.local/bin"
prepend_path "/opt/homebrew/opt/llvm/bin"
prepend_path "/opt/homebrew/bin"
prepend_path "$HOME/.luaver/lua/5.1/bin"
prepend_path "$HOME/miniforge3/bin"

if [[ -d "/Applications/Xcode.app" ]]; then
  export MANPATH="/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/share/man"
fi

###########################################
### Proxy defaults for network tooling. ###
###########################################
proxy_url="http://127.0.0.1:7897"

proxy_on() {
  export http_proxy="$proxy_url"
  export https_proxy="$proxy_url"
  export all_proxy="$proxy_url"

  if command -v git >/dev/null 2>&1; then
    git config --global http.proxy "$proxy_url"
    git config --global https.proxy "$proxy_url"
  fi
}

proxy_on

#######################
### Common aliases. ###
#######################
if command -v eza >/dev/null 2>&1; then
  alias ls="eza --icons"
  alias ll="eza --icons --long --all"
  alias la="eza --icons --all"
  alias l="eza --icons --long"
else
  alias ll="ls -all"
fi
alias vim="/opt/homebrew/bin/nvim"
alias tmux="/opt/homebrew/bin/tmux"
alias curl="curl -x ${proxy_url}"

alias codex-duckcode='CODEX_HOME="$HOME/.codex-duckcode" codex'
alias codex-duckcode-exec='CODEX_HOME="$HOME/.codex-duckcode" codex exec'



yb() {
  "$HOME/.local/bin/yadm-daily-backup" "$@"
}

#################################################
### Conda integration for interactive shells. ###
#################################################
if [[ -x "$HOME/miniconda3/bin/conda" ]]; then
  if __conda_setup="$("$HOME/miniconda3/bin/conda" 'shell.zsh' 'hook' 2>/dev/null)"; then
    eval "$__conda_setup"
  elif [[ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]]; then
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
  else
    prepend_path "$HOME/miniconda3/bin"
  fi
  unset __conda_setup
fi

#################################################
###         NVM                               ###
#################################################
export NVM_DIR="$HOME/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  source "$NVM_DIR/nvm.sh"
elif [[ -s "/opt/homebrew/opt/nvm/nvm.sh" ]]; then
  source "/opt/homebrew/opt/nvm/nvm.sh"
elif [[ -s "/usr/local/opt/nvm/nvm.sh" ]]; then
  source "/usr/local/opt/nvm/nvm.sh"
fi

if [[ -s "$NVM_DIR/bash_completion" ]]; then
  source "$NVM_DIR/bash_completion"
elif [[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ]]; then
  source "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
elif [[ -s "/usr/local/opt/nvm/etc/bash_completion.d/nvm" ]]; then
  source "/usr/local/opt/nvm/etc/bash_completion.d/nvm"
fi

#############################
### Prompt customization. ###
#############################
[[ -f "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"
