#!/bin/sh
# Run authenticated or restricted workloads against the official endpoint.
set -eu
. /etc/profile.d/huggingface.sh
if [ "$#" -eq 0 ]; then
    printf '%s\n' 'Usage: hf-private COMMAND [ARG ...]' >&2
    exit 2
fi
HF_CACHE_SCOPE=private
HF_HOME=${HF_HOME:-"$HOME/.cache/huggingface"}
HF_HUB_CACHE=${HF_PRIVATE_HUB_CACHE:-"$HF_HOME/private-hub"}
HUGGINGFACE_HUB_CACHE=$HF_HUB_CACHE
HF_ENDPOINT=https://huggingface.co
HF_HUB_DISABLE_IMPLICIT_TOKEN=0
HF_TOKEN_PATH="$HF_HOME/token"
export HF_CACHE_SCOPE HF_HOME HF_HUB_CACHE HUGGINGFACE_HUB_CACHE
export HF_ENDPOINT HF_HUB_DISABLE_IMPLICIT_TOKEN HF_TOKEN_PATH
if [ "${TRANSFORMERS_CACHE+x}" = x ]; then
    TRANSFORMERS_CACHE=$HF_HUB_CACHE
    export TRANSFORMERS_CACHE
fi
umask 077
mkdir -p -- "$HF_HOME" "$HF_HUB_CACHE"
exec "$@"
