<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yifan.yadm-daily-backup</string>

  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>mkdir -p "$HOME/Library/Logs" &amp;&amp; exec "$HOME/.local/bin/yadm-backup-on-wake" &gt;&gt;"$HOME/Library/Logs/yadm-daily-backup.log" 2&gt;&gt;"$HOME/Library/Logs/yadm-daily-backup.err.log"</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>600</integer>

</dict>
</plist>
